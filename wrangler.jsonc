{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "graph-golf",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "graph.tryonlinux.com", "custom_domain": true }
  ]
}
